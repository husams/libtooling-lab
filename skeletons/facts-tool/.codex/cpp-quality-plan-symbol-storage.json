{
  "version": 1,
  "steps": [
    {
      "name": "configure-ninja",
      "kind": "configure",
      "argv": [
        "cmake",
        "-S",
        ".",
        "-B",
        "build",
        "-G",
        "Ninja",
        "-DCMAKE_PREFIX_PATH=/opt/homebrew/opt/llvm",
        "-DCMAKE_CXX_COMPILER=/opt/homebrew/opt/llvm/bin/clang++",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "build",
      "kind": "build",
      "argv": ["cmake", "--build", "build", "--parallel"],
      "timeout_seconds": 1200
    },
    {
      "name": "focused-symbol-storage-test",
      "kind": "test",
      "argv": [
        "ctest",
        "--test-dir",
        "build",
        "--output-on-failure",
        "-R",
        "^fact-store$"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "tests",
      "kind": "test",
      "argv": ["ctest", "--test-dir", "build", "--output-on-failure"],
      "timeout_seconds": 1200
    },
    {
      "name": "format-check",
      "kind": "format",
      "argv": [
        "/opt/homebrew/opt/llvm/bin/clang-format",
        "--dry-run",
        "--Werror",
        "src/model/AnySymbol.h",
        "src/model/SymbolId.h",
        "src/model/Enumeration.h",
        "src/model/Function.h",
        "src/model/Record.h",
        "src/model/TypeAlias.h",
        "src/model/Variable.h",
        "src/ast/FactExtractor.h",
        "src/ast/FactExtractor.cpp",
        "src/ast/extractors/Extraction.h",
        "src/ast/extractors/File.cpp",
        "src/ast/extractors/FunctionDecl.h",
        "src/ast/extractors/FunctionDecl.cpp",
        "src/ast/extractors/NamedDecl.cpp",
        "src/ast/visitors/SymbolVisitor.h",
        "src/ast/visitors/SymbolVisitor.cpp",
        "src/ast/visitors/Traversal.h",
        "src/ast/visitors/Traversal.cpp",
        "src/main.cpp",
        "src/storage/Definition.cpp",
        "src/storage/Enumeration.h",
        "src/storage/Enumeration.cpp",
        "src/storage/FactStore.h",
        "src/storage/FactStore.cpp",
        "src/storage/Function.h",
        "src/storage/Function.cpp",
        "src/storage/Parameter.cpp",
        "src/storage/Record.h",
        "src/storage/Record.cpp",
        "src/storage/Schema.h",
        "src/storage/Sqlite.h",
        "src/storage/Sqlite.cpp",
        "src/storage/Storage.h",
        "src/storage/Storage.cpp",
        "src/storage/Symbol.h",
        "src/storage/Symbol.cpp",
        "src/storage/SymbolIdentity.h",
        "src/storage/SymbolIdentity.cpp",
        "src/storage/TypeAlias.h",
        "src/storage/TypeAlias.cpp",
        "src/storage/Variable.h",
        "src/storage/Variable.cpp",
        "tests/FactStoreTest.cpp",
        "tests/FileManagerTest.cpp"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "clang-tidy",
      "kind": "static-analysis",
      "argv": [
        "/opt/homebrew/opt/llvm/bin/clang-tidy",
        "-p",
        "build",
        "src/ast/FactExtractor.cpp",
        "src/ast/extractors/File.cpp",
        "src/ast/extractors/FunctionDecl.cpp",
        "src/ast/extractors/NamedDecl.cpp",
        "src/ast/visitors/SymbolVisitor.cpp",
        "src/ast/visitors/Traversal.cpp",
        "src/main.cpp",
        "src/storage/Definition.cpp",
        "src/storage/Enumeration.cpp",
        "src/storage/FactStore.cpp",
        "src/storage/Function.cpp",
        "src/storage/Parameter.cpp",
        "src/storage/Record.cpp",
        "src/storage/Sqlite.cpp",
        "src/storage/Storage.cpp",
        "src/storage/Symbol.cpp",
        "src/storage/SymbolIdentity.cpp",
        "src/storage/TypeAlias.cpp",
        "src/storage/Variable.cpp",
        "tests/FactStoreTest.cpp",
        "tests/FileManagerTest.cpp"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "smoke-extraction",
      "kind": "custom",
      "argv": [
        "./build/facts-tool",
        "--facts-out",
        "build/symbol-storage-smoke-facts.sqlite",
        "--project-config",
        "build/symbol-storage-smoke-files.sqlite",
        "tests/fixtures/tu_one.cpp",
        "tests/fixtures/tu_two.cpp",
        "--",
        "-std=c++23",
        "-Itests/fixtures"
      ],
      "timeout_seconds": 600
    }
  ]
}
