{
  "version": 1,
  "steps": [
    {
      "name": "configure-enum-tests",
      "kind": "configure",
      "argv": [
        "cmake",
        "-S",
        ".",
        "-B",
        "/tmp/facts-tool-enum-test-build",
        "-DBUILD_TESTING=ON",
        "-DLLVM_DIR=/opt/homebrew/opt/llvm/lib/cmake/llvm",
        "-DPython3_EXECUTABLE=/tmp/facts-tool-enum-test-venv/bin/python"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "build-enum-tests",
      "kind": "build",
      "argv": [
        "cmake",
        "--build",
        "/tmp/facts-tool-enum-test-build",
        "--parallel"
      ],
      "timeout_seconds": 1200
    },
    {
      "name": "run-all-tests",
      "kind": "test",
      "argv": [
        "ctest",
        "--test-dir",
        "/tmp/facts-tool-enum-test-build",
        "--output-on-failure"
      ],
      "timeout_seconds": 1200
    },
    {
      "name": "format-check",
      "kind": "format",
      "argv": [
        "/opt/homebrew/opt/llvm/bin/clang-format",
        "--dry-run",
        "--Werror",
        "src/ast/extractors/Definition.cpp",
        "src/ast/extractors/Definition.h",
        "src/ast/extractors/EnumConstantDecl.cpp",
        "src/ast/extractors/EnumConstantDecl.h",
        "src/ast/extractors/EnumDecl.cpp",
        "src/ast/extractors/EnumDecl.h",
        "src/ast/visitors/SymbolCollector.cpp",
        "src/ast/visitors/SymbolVisitor.cpp",
        "src/ast/visitors/SymbolVisitor.h",
        "src/model/AnySymbol.h",
        "src/model/Enumeration.h",
        "src/model/Enumerator.h",
        "src/storage/Enumeration.cpp",
        "src/storage/Enumerator.cpp",
        "src/storage/Enumerator.h",
        "src/storage/Parameter.cpp",
        "src/storage/Schema.h",
        "src/storage/SchemaMigration.cpp",
        "src/storage/Sqlite.cpp",
        "src/storage/Sqlite.h",
        "src/storage/Storage.h",
        "tests/StorageSchemaTest.cpp",
        "tests/fixtures/e2e/shared.hpp"
      ],
      "timeout_seconds": 300
    }
  ]
}
