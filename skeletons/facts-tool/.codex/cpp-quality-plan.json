{
  "version": 1,
  "steps": [
    {
      "name": "configure",
      "kind": "configure",
      "argv": ["cmake", "-S", ".", "-B", "build", "-DBUILD_TESTING=ON", "-DLLVM_DIR=/opt/homebrew/opt/llvm/lib/cmake/llvm"],
      "timeout_seconds": 600
    },
    {
      "name": "build",
      "kind": "build",
      "argv": ["cmake", "--build", "build", "--parallel", "4"],
      "timeout_seconds": 1200
    },
    {
      "name": "focused-tests",
      "kind": "test",
      "argv": ["ctest", "--test-dir", "build", "--output-on-failure", "-R", "^(storage-schema|file-database-persistence)$"],
      "timeout_seconds": 600
    },
    {
      "name": "all-tests",
      "kind": "test",
      "argv": ["ctest", "--test-dir", "build", "--output-on-failure"],
      "timeout_seconds": 1200
    },
    {
      "name": "format-check",
      "kind": "format",
      "argv": ["/opt/homebrew/opt/llvm/bin/clang-format", "--dry-run", "--Werror", "src/storage/StorageQuery.h", "src/storage/Definition.cpp", "src/storage/Enumeration.cpp", "src/storage/Enumerator.cpp", "src/storage/Parameter.cpp", "src/storage/RecordInstance.cpp", "src/storage/RecordTemplate.cpp", "src/storage/Relation.cpp", "src/storage/Variable.cpp", "src/storage/Symbol.cpp", "src/storage/Storage.cpp", "src/storage/FileDatabase.cpp", "tests/StorageSchemaTest.cpp", "tests/FileDatabasePersistenceTest.cpp"],
      "timeout_seconds": 300
    },
    {
      "name": "static-analysis",
      "kind": "static-analysis",
      "argv": ["/opt/homebrew/opt/llvm/bin/clang-tidy", "-p", "build", "src/storage/Definition.cpp", "src/storage/Enumeration.cpp", "src/storage/Enumerator.cpp", "src/storage/Parameter.cpp", "src/storage/RecordInstance.cpp", "src/storage/RecordTemplate.cpp", "src/storage/Relation.cpp", "src/storage/Variable.cpp", "src/storage/Symbol.cpp", "src/storage/Storage.cpp", "src/storage/FileDatabase.cpp", "tests/StorageSchemaTest.cpp", "tests/FileDatabasePersistenceTest.cpp"],
      "timeout_seconds": 1200
    }
  ]
}
