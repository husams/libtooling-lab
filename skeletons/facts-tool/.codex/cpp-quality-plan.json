{
  "version": 1,
  "steps": [
    {
      "name": "fresh-configure",
      "kind": "configure",
      "argv": [
        "cmake",
        "-G",
        "Ninja",
        "-S",
        ".",
        "-B",
        "/tmp/facts-tool-queryable-storage-build",
        "-DCMAKE_PREFIX_PATH=/opt/homebrew/opt/llvm",
        "-DCMAKE_C_COMPILER=/opt/homebrew/opt/llvm/bin/clang",
        "-DCMAKE_CXX_COMPILER=/opt/homebrew/opt/llvm/bin/clang++",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "fresh-build",
      "kind": "build",
      "argv": [
        "cmake",
        "--build",
        "/tmp/facts-tool-queryable-storage-build",
        "--parallel"
      ],
      "timeout_seconds": 1200
    },
    {
      "name": "focused-tests",
      "kind": "test",
      "argv": [
        "ctest",
        "--test-dir",
        "/tmp/facts-tool-queryable-storage-build",
        "-R",
        "^(storage-schema|facts-tool-e2e)$",
        "--output-on-failure"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "full-tests",
      "kind": "test",
      "argv": [
        "ctest",
        "--test-dir",
        "/tmp/facts-tool-queryable-storage-build",
        "--output-on-failure"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "clang-format",
      "kind": "format",
      "argv": [
        "/opt/homebrew/opt/llvm/bin/clang-format",
        "--dry-run",
        "--Werror",
        "src/storage/Parameter.cpp",
        "src/storage/Relation.cpp",
        "src/storage/SchemaMigration.cpp",
        "src/storage/SchemaMigration.h",
        "src/storage/SemanticProperties.h",
        "src/storage/Storage.cpp",
        "src/storage/Symbol.cpp",
        "tests/StorageSchemaTest.cpp"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "clang-tidy",
      "kind": "static-analysis",
      "argv": [
        "/opt/homebrew/opt/llvm/bin/clang-tidy",
        "-p",
        "/tmp/facts-tool-queryable-storage-build",
        "src/storage/Parameter.cpp",
        "src/storage/Relation.cpp",
        "src/storage/SchemaMigration.cpp",
        "src/storage/Storage.cpp",
        "src/storage/Symbol.cpp",
        "tests/StorageSchemaTest.cpp"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "python-syntax",
      "kind": "custom",
      "argv": [
        "python3",
        "-c",
        "import ast, pathlib; [ast.parse(pathlib.Path(path).read_text()) for path in ['tests/e2e/steps/database_steps.py','tests/e2e/steps/inheritance_steps.py','tests/e2e/steps/parameter_steps.py']]"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "diff-check",
      "kind": "custom",
      "argv": ["git", "diff", "--check"],
      "timeout_seconds": 120
    }
  ]
}
