{
  "version": 1,
  "steps": [
    {
      "name": "configure-ninja",
      "kind": "configure",
      "argv": [
        "cmake",
        "-S",
        ".",
        "-B",
        "build",
        "-G",
        "Ninja",
        "-DCMAKE_PREFIX_PATH=/opt/homebrew/opt/llvm",
        "-DCMAKE_CXX_COMPILER=/opt/homebrew/opt/llvm/bin/clang++"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "build",
      "kind": "build",
      "argv": ["cmake", "--build", "build", "-j", "8"],
      "timeout_seconds": 1200
    },
    {
      "name": "tests",
      "kind": "test",
      "argv": ["ctest", "--test-dir", "build", "--output-on-failure"],
      "timeout_seconds": 1200
    },
    {
      "name": "format-check",
      "kind": "format",
      "argv": [
        "/opt/homebrew/opt/llvm/bin/clang-format",
        "--dry-run",
        "--Werror",
        "src/model/FileRecord.h",
        "src/model/SymbolId.h",
        "src/storage/FactStore.h",
        "src/storage/FactStore.cpp",
        "src/storage/FileManager.h",
        "src/storage/FileManager.cpp",
        "src/storage/FileDatabase.h",
        "src/storage/FileDatabase.cpp",
        "src/storage/FileSchema.h",
        "src/tooling/CompilationFiles.h",
        "src/tooling/CompilationFiles.cpp",
        "src/storage/Schema.h",
        "src/ast/extractors/File.h",
        "src/ast/extractors/File.cpp",
        "src/ast/extractors/Extraction.h",
        "src/ast/extractors/Location.cpp",
        "src/ast/FactExtractor.cpp",
        "src/ast/visitors/Traversal.h",
        "src/ast/visitors/Traversal.cpp",
        "src/ast/visitors/SymbolVisitor.h",
        "src/ast/visitors/SymbolVisitor.cpp",
        "src/main.cpp",
        "tests/FactStoreTest.cpp",
        "tests/FileManagerTest.cpp",
        "tests/CompilationFilesTest.cpp"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "clang-tidy",
      "kind": "static-analysis",
      "argv": [
        "/opt/homebrew/opt/llvm/bin/clang-tidy",
        "-p",
        "build",
        "src/storage/FactStore.cpp",
        "src/storage/FileManager.cpp",
        "src/storage/FileDatabase.cpp",
        "src/tooling/CompilationFiles.cpp",
        "src/ast/extractors/File.cpp",
        "src/ast/FactExtractor.cpp",
        "src/ast/visitors/Traversal.cpp",
        "src/ast/visitors/SymbolVisitor.cpp",
        "tests/FactStoreTest.cpp",
        "tests/FileManagerTest.cpp",
        "tests/CompilationFilesTest.cpp"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "smoke-extraction",
      "kind": "custom",
      "argv": [
        "./build/facts-tool",
        "--facts-out",
        "build/quality-smoke-facts.sqlite",
        "--files-out",
        "build/quality-smoke-files.sqlite",
        "sample/sample.cpp",
        "--",
        "-std=c++23"
      ],
      "timeout_seconds": 600
    }
  ]
}
