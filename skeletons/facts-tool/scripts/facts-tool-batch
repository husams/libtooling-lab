#!/usr/bin/env python3
"""Run facts-tool extract or dependency for a source list."""

from pathlib import Path
import sys

from facts_batch_args import parse_args
from facts_batch_run import BatchRunError, run_batch
from facts_batch_sources import SourceError, collect_sources, output_names


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    try:
        sources = collect_sources(args, Path.cwd())
        return run_batch(args, sources, output_names)
    except SourceError as error:
        print(f"facts-tool-batch: error: {error}", file=sys.stderr)
        return 2
    except (BatchRunError, OSError) as error:
        print(f"facts-tool-batch: error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
